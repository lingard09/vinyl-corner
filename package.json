{
  "name": "vinyl-corner",
  "version": "0.1.0",
  "description": "맥에서 지금 재생 중인 노래를 화면 오른쪽 아래에 도는 LP로 띄워주는 앱",
  "author": "lingard09",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lingard09/vinyl-corner.git"
  },
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg",
    "release": "electron-builder --mac dmg --publish always"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "app.vinylcorner.mac",
    "productName": "Vinyl Corner",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "지금 재생 중인 노래를 LP로 보여주려고 Spotify와 Music에 곡 정보를 물어봅니다."
      },
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "VinylCorner-${version}-${arch}.dmg"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
